[Unit]
Description=Firewall: only the box's own services get in
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/box/firewall.nft
ExecReload=/usr/sbin/nft -f /etc/box/firewall.nft
ExecStop=/usr/sbin/nft delete table inet box

[Install]
WantedBy=sysinit.target
